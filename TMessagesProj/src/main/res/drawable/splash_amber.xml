<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- AmberGram UI 2.0 (قدم ۱۰): اسپلش سرد-استارت — کاغذ روز (توقف‌های وایپرپ روز) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFFFF6EA"
                endColor="#FFFBEEDC"/>
        </shape>
    </item>
    <item
        android:width="150dp"
        android:height="150dp"
        android:gravity="center"
        android:drawable="@drawable/splash_plane"/>
</layer-list>
