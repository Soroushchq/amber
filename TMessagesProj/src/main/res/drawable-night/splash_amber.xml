<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- AmberGram UI 2.0 (قدم ۱۱ / گرد ۲۰): اسپلش برنددار — شب گرم + هواپیما + واژه‌نگار -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FF1C1710"
                android:centerColor="#FF17130E"
            endColor="#FF12100B"/>
        </shape>
    </item>
    <item
        android:width="150dp"
        android:height="150dp"
        android:gravity="center"
        android:drawable="@drawable/splash_plane"/>
    <item
        android:width="180dp"
        android:height="41dp"
        android:gravity="center_horizontal|bottom"
        android:bottom="96dp"
        android:drawable="@drawable/splash_wordmark"/>
</layer-list>
